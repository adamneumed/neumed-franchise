---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  title: 'Terms and Conditions — NeuMed Franchise',
  description: 'Terms and conditions for use of the NeuMed Franchise website.',
};
---

<BaseLayout seo={seo} currentPage="legal" darkHero={false}>
  <section class="section legal-page">
    <div class="wrap legal-wrap">
      <h1 class="text-wrap">Terms and Conditions</h1>
      <p class="muted legal-updated">Last updated: July 16, 2026</p>

      <h2>Acceptance of Terms</h2>
      <p>
        By accessing or using neumedfranchise.com (the "Site"), you agree to these Terms and Conditions. If you do not
        agree, please do not use the Site.
      </p>

      <h2>Informational Purpose Only</h2>
      <p>
        This Site provides general information about the NeuMed franchise opportunity. Content on this Site is for
        informational purposes only and does not constitute a franchise offering, investment advice, or a guarantee of
        results.
      </p>

      <h2>No Franchise Offer</h2>
      <p>
        This is not a franchise offering. A franchise offering is made only by a Franchise Disclosure Document (FDD)
        and in compliance with applicable franchise laws. Any figures shown on the Site are illustrative unless
        expressly disclosed in an FDD.
      </p>

      <h2>Use of the Site</h2>
      <p>You agree not to misuse the Site, including by attempting to interfere with its operation, submitting false information, or using the Site for unlawful purposes.</p>

      <h2>Inquiry Submissions</h2>
      <p>
        By submitting a franchise inquiry form, you represent that the information you provide is accurate to the best
        of your knowledge and that we may contact you about the franchise opportunity using the contact details you
        provide.
      </p>

      <h2>Intellectual Property</h2>
      <p>
        All content on this Site, including text, branding, logos, photographs, and design elements, is owned by NeuMed
        or its licensors and may not be copied or used without prior written permission, except for personal,
        non-commercial viewing of the Site.
      </p>

      <h2>Third-Party Links</h2>
      <p>
        The Site may link to third-party websites, including neumed.com. We are not responsible for the content,
        policies, or practices of third-party sites.
      </p>

      <h2>Disclaimer of Warranties</h2>
      <p>
        The Site is provided "as is" and "as available." To the fullest extent permitted by law, we disclaim warranties
        of merchantability, fitness for a particular purpose, and non-infringement.
      </p>

      <h2>Limitation of Liability</h2>
      <p>
        To the fullest extent permitted by law, NeuMed and its affiliates will not be liable for any indirect,
        incidental, special, consequential, or punitive damages arising from your use of the Site.
      </p>

      <h2>Changes</h2>
      <p>
        We may update these Terms from time to time. The "Last updated" date above reflects the most recent revision.
        Continued use of the Site after changes are posted constitutes acceptance of the updated Terms.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about these Terms may be sent to
        <a href="mailto:franchise@neumed.com">franchise@neumed.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>
