---
interface Props {
  currentPage: 'home' | 'opportunity' | 'process' | 'faq' | 'contact' | 'legal';
}

const { currentPage } = Astro.props;

const pages = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'opportunity', label: 'Opportunity', href: '/opportunity' },
  { id: 'process', label: 'Process', href: '/process' },
  { id: 'faq', label: 'FAQ', href: '/faq' },
  { id: 'contact', label: 'Contact', href: '/contact' },
] as const;

const navPages = pages.filter((p) => p.id !== 'contact');
---

<header class="nav">
  <div class="wrap nav-inner">
    <div class="nav-left">
      <a href="/" class="nm-logo" aria-label="NeuMed — home">
        <img class="logo-white" src="/assets/logo-white.png" alt="NeuMed" />
        <img class="logo-color" src="/assets/logo-color.png" alt="NeuMed" />
      </a>
      <span class="nav-tag">Franchise</span>
    </div>
    <nav class="nav-links" aria-label="Main">
      {
        navPages.map((p) => (
          <a href={p.href} class:list={[{ active: p.id === currentPage }]} aria-current={p.id === currentPage ? 'page' : undefined}>
            {p.label}
          </a>
        ))
      }
      <a href="/contact" class="nm-btn nm-btn-primary" style="padding:11px 20px;font-size:14px">
        Request Info
      </a>
    </nav>
    <button
      class="nav-burger"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      id="nav-burger"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  <nav aria-label="Mobile">
    {
      pages.map((p) => (
        <a href={p.href} aria-current={p.id === currentPage ? 'page' : undefined}>{p.label}</a>
      ))
    }
    <a href="/contact" class="nm-btn nm-btn-primary">
      Request Franchise Info
    </a>
  </nav>
</div>

<script>
  const header = document.querySelector('.nav');
  const burger = document.getElementById('nav-burger');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const isMenuOpen = () => !!menu?.classList.contains('open');
  const menuLinks = () => Array.from(menu?.querySelectorAll<HTMLElement>('a') ?? []);

  const setMenuOpen = (open: boolean, restoreFocus = false) => {
    menu?.classList.toggle('open', open);
    if (menu) menu.hidden = !open;
    burger?.setAttribute('aria-expanded', open ? 'true' : 'false');
    burger?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (open) {
      menuLinks()[0]?.focus();
    } else if (restoreFocus) {
      burger?.focus();
    }
  };

  burger?.addEventListener('click', () => {
    setMenuOpen(!isMenuOpen());
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (!isMenuOpen()) return;
    if (event.key === 'Escape') {
      setMenuOpen(false, true);
      return;
    }
    // Keep Tab focus cycling within the burger button and the open menu.
    if (event.key === 'Tab' && burger) {
      const focusables = [burger, ...menuLinks()];
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (event.shiftKey && active === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      } else if (!active || !focusables.includes(active)) {
        event.preventDefault();
        first.focus();
      }
    }
  });
</script>
