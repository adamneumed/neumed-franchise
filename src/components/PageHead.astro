---
interface Props {
  eyebrow: string;
  heading: string;
  lead: string;
  imageTag: string;
  imageSrc?: string;
  imageAlt?: string;
}

const { eyebrow, heading, lead, imageTag, imageSrc, imageAlt } = Astro.props;
---

<section class="pagehead">
  {
    imageSrc ? (
      <div class="pagehead-photo slot-bg">
        <img src={imageSrc} alt={imageAlt ?? ''} loading="eager" />
      </div>
    ) : (
      <div class="slot slot-bg dark"><span class="slot-tag">{imageTag}</span></div>
    )
  }
  <div class="wash"></div>
  <div class="wrap">
    <span class="nm-eyebrow eyebrow">{eyebrow}</span>
    <h1 class="text-wrap">{heading}</h1>
    <p class="lead text-wrap">{lead}</p>
  </div>
</section>
