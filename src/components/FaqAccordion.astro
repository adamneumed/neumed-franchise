---
import type { FaqItem } from '../lib/seed';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item, index) => {
      const panelId = `faq-panel-${index}`;
      const buttonId = `faq-button-${index}`;
      const isOpen = !!item.openByDefault;
      return (
        <div class:list={['faq-item', { open: isOpen }]}>
          <button
            class="faq-q"
            type="button"
            id={buttonId}
            aria-expanded={isOpen ? 'true' : 'false'}
            aria-controls={panelId}
          >
            {item.question}
            <span class="pm" aria-hidden="true">+</span>
          </button>
          <div class="faq-a" id={panelId} role="region" aria-labelledby={buttonId}>
            <div class="faq-a-inner">{item.answer}</div>
          </div>
        </div>
      );
    })
  }
</div>

<script>
  const setOpen = (a: HTMLElement) => {
    a.style.maxHeight = `${a.scrollHeight}px`;
  };

  document.querySelectorAll('.faq-item.open .faq-a').forEach((a) => {
    const el = a as HTMLElement;
    const prev = el.style.transition;
    el.style.transition = 'none';
    setOpen(el);
    void el.offsetHeight;
    el.style.transition = prev;
  });

  document.querySelectorAll('.faq-item').forEach((item) => {
    const q = item.querySelector('.faq-q') as HTMLButtonElement | null;
    const a = item.querySelector('.faq-a') as HTMLElement | null;
    q?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      const group = item.closest('.faq');
      group?.querySelectorAll('.faq-item.open').forEach((o) => {
        if (o !== item) {
          o.classList.remove('open');
          const panel = o.querySelector('.faq-a') as HTMLElement;
          const btn = o.querySelector('.faq-q') as HTMLButtonElement | null;
          panel.style.maxHeight = '';
          btn?.setAttribute('aria-expanded', 'false');
        }
      });
      if (open) {
        item.classList.remove('open');
        if (a) a.style.maxHeight = '';
        q.setAttribute('aria-expanded', 'false');
      } else {
        item.classList.add('open');
        if (a) setOpen(a);
        q.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
