---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AccessibilityWidget from '../components/AccessibilityWidget.astro';
import RevealScript from '../components/RevealScript.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import type { Seo } from '../lib/seed';

interface Props {
  seo: Seo;
  currentPage: 'home' | 'opportunity' | 'process' | 'faq' | 'contact' | 'legal';
  darkHero?: boolean;
}

const { seo, currentPage, darkHero = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <script is:inline>
      // Apply saved accessibility preferences before first paint to avoid flashes.
      (function () {
        try {
          var p = JSON.parse(localStorage.getItem('nm-a11y') || '{}');
          var c = document.documentElement.classList;
          if (p.text === 'lg') c.add('a11y-text-lg');
          if (p.text === 'xl') c.add('a11y-text-xl');
          if (p.contrast) c.add('a11y-contrast');
          if (p.motion) c.add('a11y-reduce-motion');
          if (p.pause) c.add('a11y-no-reveal');
        } catch (e) {}
      })();
    </script>
    <GoogleAnalytics />
  </head>
  <body data-page={currentPage} class:list={[{ 'dark-hero': darkHero }]}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader currentPage={currentPage} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <AccessibilityWidget />
    <RevealScript />
  </body>
</html>
